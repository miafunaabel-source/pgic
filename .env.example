# Copier ce fichier en .env.local et remplir les valeurs
# NE JAMAIS commiter .env.local sur Git

# NextAuth — générer avec: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_32
NEXTAUTH_URL=http://localhost:3000

# Base de données (à configurer lors de la migration vers PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/pgic

# En production uniquement
# NEXTAUTH_URL=https://votre-domaine.fr
